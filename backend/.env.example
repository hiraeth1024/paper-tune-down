# PaperTune 后端环境变量
# 复制此文件为 backend/.env 并填入实际值

# ---- Supabase ----
# 项目 URL 和密钥，登录 https://supabase.com/dashboard 获取
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ---- CORS ----
# 允许的前端域名，逗号分隔
CORS_ORIGINS=http://localhost:3000

# ---- JWT ----
# 生产环境请替换为随机生成的强密钥
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=papertune-dev-secret-change-in-prod

# ---- 邮箱验证码 ----
# 发送方式: dev(控制台打印) | resend | smtp
EMAIL_PROVIDER=dev

# Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=PaperTune <noreply@papertune.cn>

# SMTP (自建邮件服务器)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
